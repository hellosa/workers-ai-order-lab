{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workers-ai-order-lab",
  "main": "worker.js",
  "compatibility_date": "2026-10-20",
  "ai": { "binding": "AI" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "observability": { "enabled": false }
}
